{
  "output_dir": null,
  "job_name": "hilserl_yellow_v1",
  "resume": false,
  "seed": 1000,
  "num_workers": 4,
  "batch_size": 256,
  "steps": 100000,
  "log_freq": 500,
  "save_checkpoint": true,
  "save_freq": 5000,
  "wandb": {
    "enable": true,
    "project": "projet3-hilserl",
    "entity": "tom-gazzini-ethrc",
    "disable_artifact": true
  },
  "dataset": {
    "repo_id": "osammotg1/projet3-hilserl-yellow-v1-cropped",
    "use_imagenet_stats": false
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "task": "hilserl_pick_yellow_v1",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/tty.usbmodem5B141129871",
      "id": "so101_follower",
      "use_degrees": true,
      "cameras": {
        "wrist": {
          "type": "opencv",
          "index_or_path": 0,
          "width": 640,
          "height": 480,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/tty.usbmodem5B141128171",
      "id": "so101_leader",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "max_gripper_pos": 100.0,
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [128, 128]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": true,
        "fixed_reset_joint_positions": null
      },
      "inverse_kinematics": {
        "urdf_path": "sim/hilserl/assets/so101/urdf/so_arm101.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [-0.30, -0.30, 0.02],
          "max": [0.50, 0.30, 0.40]
        },
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        }
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.7,
        "success_reward": 1.0
      }
    }
  },
  "policy": {
    "type": "sac",
    "n_obs_steps": 1,
    "repo_id": "osammotg1/projet3-hilserl-yellow-v1-policy",
    "device": "cuda",
    "storage_device": "cuda",
    "use_amp": false,
    "temperature_init": 1e-2,
    "discount": 0.99,
    "num_critics": 10,
    "num_subsample_critics": 2,
    "critic_lr": 3e-4,
    "actor_lr": 3e-4,
    "temperature_lr": 3e-4,
    "policy_update_freq": 1,
    "critic_target_update_weight": 0.005,
    "online_buffer_capacity": 100000,
    "offline_buffer_capacity": 100000,
    "actor_learner_config": {
      "policy_parameters_push_frequency": 1.5
    },
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX",
      "ACTION": "MIN_MAX"
    },
    "input_features": {
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [12]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [4]
      }
    }
  }
}
